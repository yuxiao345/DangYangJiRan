<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug 专用：钉死 CloudKit Development 环境 —— 默认值不是保证（Apple 原文与
	     全部理由见根 CLAUDE.md「开发 / 生产环境隔离」）。Release / 分发版**不要**加这个键。 -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.qianey.v2</string>
	</array>
	<key>com.apple.developer.icloud-extended-share-access</key>
	<array>
		<string>InProcessShareAccessRequests</string>
		<string>InProcessShareOwnerParticipantInfo</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.qianey</string>
</dict>
</plist>
